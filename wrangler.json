{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": ".open-next/worker.js",
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ENABLE_AI_CHAT": "true",
    "NEXT_PUBLIC_ENABLE_AI_CHAT": "true",
    "NEXT_PUBLIC_SUPABASE_URL": "https://mrwwzeclxfyaxjygujum.supabase.co"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "routes": [
    {
      "pattern": "nickb.net",
      "custom_domain": true
    },
    {
      "pattern": "www.nickb.net",
      "custom_domain": true
    }
  ]
}
